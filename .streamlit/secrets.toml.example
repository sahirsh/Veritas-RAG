# Template for Streamlit secrets / env config.
#
# DO NOT commit a real secrets.toml — only this example file.
# The .gitignore already ignores .streamlit/secrets.toml.
#
# Streamlit Community Cloud:
#   Settings -> Secrets -> paste with real values.
#
# Cloud Run (frontend service):
#   Prefer environment variables on the service instead of secrets.toml:
#     VERITAS_API_URL=https://YOUR-API-SERVICE-xxxxx.run.app
#     VERITAS_COOKIE_SECURE=true
#   app.py reads VERITAS_API_URL from st.secrets OR the environment.
#
# Locally: copy this file to .streamlit/secrets.toml and edit.

# URL of your deployed FastAPI backend (no trailing slash).
VERITAS_API_URL = ""
