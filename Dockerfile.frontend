# Streamlit frontend for Cloud Run (and local smoke tests).
# Deploy as a *separate* Cloud Run service from the FastAPI API image.
#
# Build:
#   docker build -f Dockerfile.frontend -t veritas-rag-frontend .
# Run locally (API must be reachable):
#   docker run --rm -p 8080:8080 \
#     -e PORT=8080 \
#     -e VERITAS_API_URL=http://host.docker.internal:8000 \
#     veritas-rag-frontend

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Streamlit defaults; Cloud Run overrides PORT at runtime.
    PORT=8080 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_SERVER_ENABLE_CORS=false \
    STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

WORKDIR /app

RUN adduser --disabled-password --gecos "" appuser

COPY requirements-frontend.txt ./
RUN pip install --no-cache-dir -r requirements-frontend.txt

COPY app.py ./
COPY .streamlit ./.streamlit

USER appuser

EXPOSE 8080

# Cloud Run injects PORT (usually 8080). Use shell form so $PORT expands.
CMD ["sh", "-c", "streamlit run app.py --server.port=${PORT} --server.address=0.0.0.0"]
