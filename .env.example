# ── Local Postgres (docker-compose) ───────────────────────────────────
# When deploying to the cloud, replace DATABASE_URL with your managed
# Postgres connection string (e.g. from Neon). Cloud Postgres requires
# sslmode=require, not sslmode=disable.
POSTGRES_DB=veritas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritas?sslmode=disable

# ── Gemini (required for upload embeddings and /query retrieval) ──────
GEMINI_API_KEY=your-gemini-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Groq (required for /query answers) ────────────────────────────────
GROQ_API_KEY=gsk-your-key-here
GROQ_CHAT_MODEL=openai/gpt-oss-20b
#llama-3.1-8b-instant discontinued for groq, use openai/gpt-oss-20b

# ── API ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
PORT=8000
# Comma-separated list of allowed frontend origins. Use "*" for local dev.
# In production, set to your Streamlit Cloud URL, e.g.
#   CORS_ORIGINS=https://veritas-rag.streamlit.app
CORS_ORIGINS=*

# ── Frontend (Streamlit) ──────────────────────────────────────────────
# Used by app.py to find the backend. Locally this defaults to
# http://localhost:8000 if unset. On Streamlit Cloud, set this via the
# "Secrets" panel instead (see .streamlit/secrets.toml.example).
# VERITAS_API_URL=http://localhost:8000
