# Postgres (local or docker-compose)
POSTGRES_DB=veritas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritas?sslmode=disable

# Gemini (required for upload embeddings and /query retrieval)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq (required for /query answers)
GROQ_API_KEY=gsk-your-key-here
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# API
UPLOAD_DIR=uploads
PORT=8000
CORS_ORIGINS=*
